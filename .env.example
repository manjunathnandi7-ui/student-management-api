# Environment Configuration File
# Copy this file to .env and fill in the values

# OpenAI API Configuration (Required for Chatbot)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Server Port (Optional - defaults to 8080 locally, uses $PORT on cloud)
PORT=8080

# Database Configuration (Optional - uses H2 in-memory by default)
SPRING_DATASOURCE_URL=jdbc:h2:mem:studentdb
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Logging Level (Optional)
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_EXAMPLE_STUDENTMANAGEMENT=DEBUG
